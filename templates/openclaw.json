{
  "meta": { "lastTouchedVersion": "2026.9.4" },
  "gateway": {
    "auth": { "token": "${OPENCLAW_GATEWAY_TOKEN}" },
    "bind": "127.0.0.1"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "tokenFile": "/data/etc/openclaw/telegram-bot-token",
      "allowFrom": ["tg:${TELEGRAM_OWNER_ID}"],
      "streaming": "partial"
    }
  },
  "commands": {
    "ownerAllowFrom": ["telegram:YOUR_TELEGRAM_USER_ID"]
  },
  "agents": {
    "entries": {
      "main": {
        "name": "Main",
        "identity": { "emoji": "\ud83c\udf19" },
        "tools": { "elevated": { "allowFrom": { "telegram": ["tg:YOUR_TELEGRAM_USER_ID"] } } }
      }
    },
    "defaults": {
      "model": { "primary": "YOUR_PRIMARY_MODEL_HERE" },
      "fallbacks": [],
      "compaction": { "mode": "safeguard", "timeoutSeconds": 120 },
      "streaming": { "mode": "partial" },
      "timeoutSeconds": 40
    }
  },
  "models": {
    "providers": {
      "YOUR_PROVIDER_ID": {
        "api": "openai-completions",
        "baseUrl": "YOUR_API_BASE_URL",
        "apiKey": "***",
        "models": [
          { "id": "YOUR_MODEL_ID", "reasoning": false }
        ]
      }
    }
  }
}
