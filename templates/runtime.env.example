# ============================================================
# OpenClaw Gateway Runtime Environment
# ============================================================
# Copy to: /data/etc/openclaw/runtime.env
# Set permissions: chmod 600 runtime.env
# NEVER commit real values to git.
#
# Each variable is injected into the gateway container.
# Docker Compose reads this file via env_file directive.
# ============================================================

# --- Image versions (used in docker-compose) ---
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:YOUR_OPENCLAW_VERSION_HERE
MIHOMO_IMAGE=metacubex/mihomo:YOUR_MIHOMO_VERSION_HERE

# --- Gateway authentication ---
# Token for CLI/API access. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=YOUR_GATEWAY_TOKEN_HERE

# --- Model provider API keys ---
# At least one required. Leave empty if not using.
ZAI_API_KEY=YOUR_ZAI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# --- Telegram bot ---
# Get from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Your Telegram user ID (from @userinfobot)
TELEGRAM_OWNER_ID=YOUR_TELEGRAM_USER_ID_HERE

# --- GitHub (for updates, not required) ---
GH_TOKEN=YOUR_GITHUB_PAT_HERE

# --- Timezone ---
TZ=Asia/Shanghai

# --- Optional: proxy for model API calls ---
# If your model provider needs a proxy, set these.
# If mihomo TUN handles it, leave empty.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
